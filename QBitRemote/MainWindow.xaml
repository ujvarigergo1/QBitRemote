<Window x:Class="QBitRemote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QBitRemote" xmlns:infra="clr-namespace:QBitRemote.Infrastructure" Title="QBitRemote" Icon="pack://application:,,,/Assets/QBitRemote.ico" Width="1180" Height="720" MinWidth="920" MinHeight="520" FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,10"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackground}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="#2563EB" Margin="0,0,9,0"><TextBlock Text="Q" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="QBitRemote" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E0F2FE" CornerRadius="12" Padding="10,5" Margin="16,0,10,0"><TextBlock Text="{Binding Connection}" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Click="AddTorrent_Click" ToolTip="{infra:Loc BrowseTorrents}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"/></Button><Button Click="Connection_Click" ToolTip="{infra:Loc Connection}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;"/></Button><Button Command="{Binding RefreshCommand}" ToolTip="{infra:Loc Refresh}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/></Button><Grid><Button Command="{Binding ToggleFiltersCommand}" ToolTip="{infra:Loc Filters}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71C;"/></Button><Border Background="#DC2626" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Button Click="Settings_Click" ToolTip="{infra:Loc Settings}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/></Button></StackPanel>
    </Grid></Border>
    <Border Grid.Row="1" Margin="20" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"><Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10" Visibility="{Binding ShowFilters, Converter={StaticResource BooleanToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="{infra:Loc Name}" FontSize="11" Foreground="{DynamicResource MutedText}"/><TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="{infra:Loc Status}" FontSize="11" Foreground="{DynamicResource MutedText}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus}"/></StackPanel><StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="{infra:Loc Category}" FontSize="11" Foreground="{DynamicResource MutedText}"/><ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding FilterCategory}"/></StackPanel><StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="{infra:Loc Tags}" FontSize="11" Foreground="{DynamicResource MutedText}"/><ComboBox ItemsSource="{Binding TagOptions}" SelectedItem="{Binding FilterTag}"/></StackPanel></Grid></Border>
      <DataGrid Grid.Row="1" x:Name="TorrentGrid" ItemsSource="{Binding TorrentsView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" BorderThickness="0" HeadersVisibility="Column" RowHeight="38" SelectionMode="Extended" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseRightButtonDown="TorrentGrid_PreviewMouseRightButtonDown" MouseDoubleClick="TorrentGrid_MouseDoubleClick" Sorting="TorrentGrid_Sorting">
        <DataGrid.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></DataGrid.Resources>
        <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{infra:Loc OpenDetails}" Tag="details" Click="ContextAction_Click"/><Separator/><MenuItem Header="{infra:Loc Start}" Tag="resume" Click="ContextAction_Click"/><MenuItem Header="{infra:Loc Pause}" Tag="pause" Click="ContextAction_Click"/><MenuItem Header="{infra:Loc ForceRecheck}" Tag="recheck" Click="ContextAction_Click"/><Separator/><MenuItem Header="{infra:Loc ChangeLocation}" Tag="location" Click="ContextAction_Click"/><MenuItem Header="{infra:Loc ChangeCategory}" Tag="category" Click="ContextAction_Click"/><MenuItem Header="{infra:Loc AddTags}" Tag="addtags" Click="ContextAction_Click"/><MenuItem Header="{infra:Loc RemoveTags}" Tag="removetags" Click="ContextAction_Click"/><Separator/><MenuItem Header="{infra:Loc DeleteTorrent}" Tag="delete" Click="ContextAction_Click"/></ContextMenu></DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{infra:Loc Name}" Binding="{Binding Name}" SortMemberPath="Name" Width="300" MinWidth="245"/>
          <DataGridTemplateColumn Header="{infra:Loc Progress}" SortMemberPath="Progress" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel VerticalAlignment="Center"><TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat={}{0:P0}}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="6,0,0,0"/><ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{infra:Loc Status}" SortMemberPath="Status" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel LastChildFill="True" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Left" Text="{Binding StatusIcon}" FontWeight="SemiBold" Width="22" Margin="0,0,4,0" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{infra:Loc Added}" Binding="{Binding AddedOn, StringFormat={}{0:g}}" SortMemberPath="AddedOn" Width="145"/>
          <DataGridTemplateColumn Header="{infra:Loc Down}" SortMemberPath="DownloadSpeed" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DownloadSpeed, Converter={x:Static local:MainWindow.SpeedConverter}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{infra:Loc Up}" SortMemberPath="UploadSpeed" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding UploadSpeed, Converter={x:Static local:MainWindow.SpeedConverter}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{infra:Loc Category}" Binding="{Binding Category}" SortMemberPath="Category" Width="90"/>
          <DataGridTextColumn Header="{infra:Loc Tags}" Binding="{Binding Tags}" SortMemberPath="Tags" Width="110"/>
          <DataGridTemplateColumn Header="{infra:Loc Actions}" CanUserSort="False" Width="142"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Tag="{Binding}" Click="Details_Click" Padding="5,2" Margin="1" ToolTip="{infra:Loc Details}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;"/></Button><Button Tag="{Binding}" Click="Pause_Click" Padding="5,2" Margin="1" ToolTip="{infra:Loc Pause}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;"/></Button><Button Tag="{Binding}" Click="Resume_Click" Padding="5,2" Margin="1" ToolTip="{infra:Loc Start}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;"/></Button><Button Tag="{Binding}" Click="Delete_Click" Padding="5,2" Margin="1" ToolTip="{infra:Loc Delete}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid></Border>
  </Grid>
</Window>
