<Window x:Class="QBitRemote.Views.TorrentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QBitRemote.Infrastructure"
        Title="{Binding Name}" Width="850" Height="620" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Name}" Margin="18" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="{infra:Loc General}"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding General}" Margin="16"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Key}" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
            <TabItem Header="{infra:Loc Files}"><DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="{infra:Loc Path}" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="{infra:Loc Size}" Binding="{Binding Size}" Width="120"/><DataGridTextColumn Header="{infra:Loc Progress}" Binding="{Binding Progress}" Width="90"/><DataGridTextColumn Header="{infra:Loc Priority}" Binding="{Binding Priority}" Width="90"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{infra:Loc Peers}"><DataGrid ItemsSource="{Binding Peers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="150"/><DataGridTextColumn Header="{infra:Loc Client}" Binding="{Binding Client}" Width="110"/><DataGridTextColumn Header="{infra:Loc Progress}" Binding="{Binding Progress}" Width="90"/><DataGridTextColumn Header="{infra:Loc Down}" Binding="{Binding Down}" Width="100"/><DataGridTextColumn Header="{infra:Loc Up}" Binding="{Binding Up}" Width="100"/><DataGridTextColumn Header="{infra:Loc Flags}" Binding="{Binding Flags}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{infra:Loc Trackers}"><DataGrid ItemsSource="{Binding Trackers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="{infra:Loc Url}" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="{infra:Loc Status}" Binding="{Binding Status}" Width="140"/><DataGridTextColumn Header="{infra:Loc Message}" Binding="{Binding Message}" Width="280"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{infra:Loc Connection}"><ItemsControl ItemsSource="{Binding Connection}" Margin="16"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Key}" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem>
        </TabControl>
    </Grid>
</Window>
