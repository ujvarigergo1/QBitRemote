<Window x:Class="QBitRemote.Views.AddTorrentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QBitRemote" xmlns:infra="clr-namespace:QBitRemote.Infrastructure" Title="{infra:Loc AddTorrent}" Width="730" Height="650" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TorrentSwitchPanel" Visibility="Collapsed" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{infra:Loc SelectedTorrent}" VerticalAlignment="Center"/><ComboBox x:Name="TorrentSelector" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="TorrentSelector_SelectionChanged"/><Button Grid.Column="2" Content="{infra:Loc ApplyToAll}" Click="ApplyToAll_Click" Margin="8,3,0,3"/></Grid>
  <StackPanel Grid.Row="1"><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Size}" Foreground="#64748B" Margin="0,3,0,14"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{infra:Loc SavePath}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Paths}" Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{infra:Loc Category}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" SelectionChanged="Category_SelectionChanged"/></Grid>
   <Grid Margin="0,5,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{infra:Loc Tags}" VerticalAlignment="Top" Margin="0,6,0,0"/><ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3,14,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
  </StackPanel>
  <DockPanel Grid.Row="2" Margin="0,10,0,5"><TextBlock Text="{infra:Loc Files}" FontWeight="SemiBold" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{infra:Loc SelectAll}" Click="SelectAll_Click"/><Button Content="{infra:Loc SelectNone}" Click="SelectNone_Click"/></StackPanel></DockPanel>
  <ListView Grid.Row="3" ItemsSource="{Binding Files}" BorderBrush="#CBD5E1"><ListView.View><GridView><GridViewColumn Width="42"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="{infra:Loc File}" Width="500" DisplayMemberBinding="{Binding Path}"/><GridViewColumn Header="{infra:Loc Size}" Width="110"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size, Converter={x:Static local:MainWindow.SizeConverter}}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
  <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Content="{infra:Loc AddPaused}" IsChecked="{Binding Paused}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{infra:Loc Cancel}" IsCancel="True"/><Button Content="{infra:Loc AddTorrent}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Add_Click"/></StackPanel></Grid>
 </Grid>
</Window>
